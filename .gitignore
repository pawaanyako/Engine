# CMake build artifacts
build/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cbp # CodeBlocks project files (if used alongside VS Code)
*.vcxproj* # Visual Studio project files (if generated by CMake)
*.sln # Visual Studio solution files (if generated by CMake)

# Visual Studio Code specific files
.vscode/

# Other common build/temporary files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.pdb # Program Database files
*.ilk # Incremental Linker files
*.log
*.tmp
*.swp # Vim swap files (if used)
*~ # Backup files generated by some editors