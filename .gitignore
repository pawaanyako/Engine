# CMake build artifacts
build/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Generated project files
# (CodeBlocks / Visual Studio, if CMake generates them)
*.cbp
*.vcxproj*
*.sln
*.slnx
*.dir/

# IDE / editor
.vscode/
.vs/
.cache/
compile_commands.json

# Compiled objects and binaries
# (no *.obj here on purpose - 3D models use the same extension)
*.o
*.exe
*.dll
*.so
*.a
*.lib

# Debug info
# (.pdb - Program Database, .ilk - Incremental Linker)
*.pdb
*.ilk

# Temporary files
*.log
*.tmp
# Vim swap files
*.swp
# Editor backup files
*~

# Blender backups
*.blend1
*.blend2

# Heavy 3D models - keep only lightweight test models in the repo
resources/models/*
!resources/models/suzanne/
!resources/models/pigeon3/
